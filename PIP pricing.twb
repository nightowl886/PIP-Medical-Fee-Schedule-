      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0xokk6a02mo5c314dbuyg01s2bjz]&quot;' value='Avg Fac Fee' />
        </aliases>
      </column>
      <column caption='HCPCS Category' datatype='string' name='[Calculation_2093738887524353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [hcpcs_code] &gt;= 10000&#10;AND [hcpcs_code] &lt;= 19999&#10;THEN &quot;Integumentary&quot;&#10;&#10;ELSEIF [hcpcs_code] &gt;= 20000&#10;AND [hcpcs_code] &lt;= 29999&#10;THEN &quot;MSK&quot;&#10;&#10;ELSEIF [hcpcs_code] &gt;= 30000&#10;AND [hcpcs_code] &lt;= 39999&#10;THEN &quot;Respiratory&quot;&#10;&#10;ELSEIF [hcpcs_code] &gt;= 40000&#10;AND [hcpcs_code] &lt;= 49999&#10;THEN &quot;Digestive&quot;&#10;&#10;ELSEIF [hcpcs_code] &gt;= 50000&#10;AND [hcpcs_code] &lt;= 59999&#10;THEN &quot;GU / OB-GYN&quot;&#10;&#10;ELSEIF [hcpcs_code] &gt;= 60000&#10;AND [hcpcs_code] &lt;= 69999&#10;THEN &quot;Neuro / ENT&quot;&#10;&#10;ELSEIF [hcpcs_code] &gt;= 70000&#10;AND [hcpcs_code] &lt;= 79999&#10;THEN &quot;Rad&quot;&#10;&#10;ELSEIF [hcpcs_code] &gt;= 80000&#10;AND [hcpcs_code] &lt;= 89999&#10;THEN &quot;Lab / Path&quot;&#10;&#10;ELSEIF [hcpcs_code] &gt;= 90000&#10;&#10;THEN &quot;Medicine&quot;&#10;&#10;ELSE &quot;Other&quot;&#10;&#10;END' />
      </column>
      <column caption='Gap amount' datatype='real' name='[Calculation_2093739184041986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[non_fac_fee_schedule_amt] &#10;- [fac_fee_schedule_amt]' />
      </column>
      <column caption='Gap %' datatype='real' name='[Calculation_2093739189682179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([non_fac_fee_schedule_amt]&#10;-&#10;[fac_fee_schedule_amt])&#10;/&#10;[non_fac_fee_schedule_amt]' />
      </column>
      <column caption='State Group' datatype='string' name='[Calculation_2093739271811076]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF [state_acronym] = &apos;NY1&apos;&#10;OR [state_acronym] = &apos;NY2&apos;&#10;OR [state_acronym] = &apos;NY3&apos;&#10;&#10;THEN &apos;NY&apos;&#10;&#10;ELSEIF [state_acronym] = &apos;CA1&apos;&#10;OR [state_acronym] = &apos;CA2&apos;&#10;THEN &apos;CA&apos;&#10;&#10;ELSE&#10;[state_acronym]&#10;END' />
      </column>
      <column caption='Gap Status' datatype='string' name='[Calculation_2093739540201478]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2093739189682179] = 0&#10;THEN &quot;No Gap&quot;&#10;ELSE &quot;Has Gap&quot;&#10;END' />
      </column>
      <column caption='deviation' datatype='real' name='[Calculation_2093739560865799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([non_fac_fee_schedule_amt]) / WINDOW_AVG(AVG([non_fac_fee_schedule_amt]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='No Gap HCPCS Count' datatype='integer' name='[Calculation_2093739589836808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [Calculation_2093739540201478] = &quot;No Gap&quot;&#10;THEN [hcpcs_code]&#10;END&#10;)' />
      </column>
      <column caption='Total HCPCS Count' datatype='integer' name='[Calculation_2093739591561225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([hcpcs_code])' />
      </column>
      <column caption='No Gap %' datatype='real' name='[Calculation_2093739591933962]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;IF [Calculation_2093739540201478]=&quot;No Gap&quot;&#10;THEN [hcpcs_code]&#10;END&#10;)&#10;/&#10;COUNTD([hcpcs_code])' />
      </column>
      <column caption='# of Records' datatype='integer' name='[Calculation_4361688888283136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
